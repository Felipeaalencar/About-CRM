{
  "name": "About Inbox",
  "short_name": "Inbox",
  "description": "Demandas do WhatsApp em um lugar só, até virarem Lead no About CRM.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0614",
  "theme_color": "#0a0614",
  "lang": "pt-BR",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["audio/*", "image/*", "video/*", "application/pdf", ".opus", ".ogg", ".m4a"] }
      ]
    }
  },
  "shortcuts": [
    { "name": "Gravar áudio", "url": "./?acao=gravar", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Colar mensagem", "url": "./?acao=colar", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
